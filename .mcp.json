{
	"mcpServers": {
		"kern-mcp": {
			"command": "npx",
			"args": ["-y", "@leonio/kern-ux-mcp"],
			"directTools": true
		},
		"kolibri-mcp": {
			"type": "http",
			"url": "https://public-ui-kolibri-mcp.vercel.app/mcp",
			"directTools": true
		},
		"playwright": {
			"command": "npx",
			"args": [
				"-y",
				"@playwright/mcp@0.0.79",
				"--headless",
				"--isolated",
				"--viewport-size",
				"1280,900",
				"--allowed-origins",
				"http://localhost:4174;http://localhost:3001",
				"--output-dir",
				".playwright-mcp"
			],
			"directTools": true
		}
	}
}
