name: Mistral Vibe PR Fixup (Findings umsetzen)

# Reagiert auf das Label "ai:needs-changes" (vom Review gesetzt) und setzt die
# zutreffenden Findings um. Ersetzt claude-pr-fixup.yml (MIG-001, 2026-07-10).
#
# Label-Steuerung:
#   review ? ai:needs-changes ? fixup ? ai:needs-review ? review ? ... bis ?
#
# Setzt Mistral Vibe Agent (Nous Research) -- Provider waehlbar per PR-Label:
#   ai:use-openrouter (Default): DeepSeek via OpenRouter (MISTRAL_API_KEY)
#   ai:use-nous:         Nous Portal direkt (MISTRAL_API_KEY)
#   ai:use-zai:          Z.AI direkt (MISTRAL_API_KEY, GLM-Modelle)
# Ohne Label ? OpenRouter + DeepSeek.
#
# Voraussetzungen: MISTRAL_API_KEY

on:
  pull_request:
    types: [labeled]

concurrency:
  group: vibe-pr-fixup-${{ github.event.pull_request.number }}
  cancel-in-progress: true # Neuer Fixup-Lauf bricht laufenden ab (nur nach neuem Review-Urteil)

jobs:
  fixup:
    if: >-
      ${{ github.event.label.name == 'ai:needs-changes'
          && github.event.pull_request.draft == false
          && github.event.pull_request.head.repo.full_name == github.repository
          && (contains(github.event.pull_request.labels.*.name, 'ai:use-mistral') || contains(github.event.pull_request.labels.*.name, 'ai:use-nous') || contains(github.event.pull_request.labels.*.name, 'ai:use-zai') || !contains(github.event.pull_request.labels.*.name, 'ai:use-claude')) }}
    runs-on: ubuntu-latest
    env:
      VIBE_HOME: /tmp/vibe-ci
      PATH: /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/runner/.local/bin
    permissions:
      contents: read
      id-token: write
      actions: read
      pull-requests: write
    steps:
      - name: Startzeit merken (fuer Timeout-Erkennung + weiches Zeitlimit)
        id: starttime
        run: |
          now=$(date +%s)
          echo "epoch=$now" >> "$GITHUB_OUTPUT"
          echo "soft_deadline_epoch=$((now + 600))" >> "$GITHUB_OUTPUT"  # 10 min (Puffer vor 20-Min-GitHub-Timeout)

      - name: Voraussetzung pruefen (GitHub-App-Secrets)
        id: preflight
        env:
          APP_ID: ${{ secrets.APP_ID }}
          APP_PRIVATE_KEY: ${{ secrets.APP_PRIVATE_KEY }}
        run: |
          if [ -z "$APP_ID" ] || [ -z "$APP_PRIVATE_KEY" ]; then
            echo "::warning::GitHub-App-Secrets fehlen -- Lauf wird uebersprungen."
            echo "configured=false" >> "$GITHUB_OUTPUT"
          else
            echo "configured=true" >> "$GITHUB_OUTPUT"
          fi
      - name: GitHub-App-Token erzeugen
        id: app-token
        if: steps.preflight.outputs.configured == 'true'
        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
        with:
          client-id: ${{ secrets.APP_ID }}
          private-key: ${{ secrets.APP_PRIVATE_KEY }}

      - name: GH_TOKEN-Fallback setzen (App-Token oder GITHUB_TOKEN)
        id: gh-token
        run: |
          APP_TOK="${{ steps.app-token.outputs.token }}"
          if [ -n "$APP_TOK" ] && [ "$APP_TOK" != "null" ]; then
            echo "token=$APP_TOK" >> "$GITHUB_OUTPUT"
            echo "::notice::Nutze GitHub-App-Token fuer gh-Befehle."
          else
            echo "token=${{ github.token }}" >> "$GITHUB_OUTPUT"
            echo "::warning::App-Token nicht verfuegbar -- nutze GITHUB_TOKEN (Achtung: Label-Wechsel loesen ggf. keine Folge-Workflows aus)."
          fi

      - name: Checkout (PR-Head-Branch)
        if: steps.preflight.outputs.configured == 'true'
        uses: actions/checkout@v7
        with:
          fetch-depth: 0
          ref: ${{ github.event.pull_request.head.ref }}
          token: ${{ steps.gh-token.outputs.token }}

      - name: Cache-Key fuer uv berechnen
        id: uv-cache-key
        run: echo "week=$(date +%Y-W%V)" >> "$GITHUB_OUTPUT"

      - name: uv-Paketcache wiederherstellen
        id: uv-cache
        uses: actions/cache@v4
        with:
          path: |
            ~/.cache/uv
            ~/.local/share/uv
          key: uv-vibe-${{ runner.os }}-${{ steps.uv-cache-key.outputs.week }}
          restore-keys: uv-vibe-${{ runner.os }}-

      - name: Mistral Vibe installieren
        if: steps.preflight.outputs.configured == 'true'
        run: |
          curl -fsSL https://vibe-agent.nousresearch.com/install.sh | bash -s -- --skip-browser --skip-setup
          echo "$HOME/.local/bin" >> $GITHUB_PATH

      - name: Mistral Vibe konfigurieren (Provider anhand PR-Label)
        if: steps.preflight.outputs.configured == 'true'
        env:
          GH_TOKEN: ${{ steps.gh-token.outputs.token }}
          PR: ${{ github.event.pull_request.number }}
        run: |
          # Provider anhand des PR-Labels waehlen
          LABELS=$(gh pr view $PR --repo $GITHUB_REPOSITORY --json labels --jq '.labels[].name' 2>/dev/null || echo "")
          if echo "$LABELS" | grep -q 'ai:use-nous'; then
            echo "::notice::Provider: Nous Portal (ai:use-nous)"
            vibe config set model.provider mistral
            vibe config set model.base_url https://api.mistral.ai/v1
            vibe auth add nous --type api-key --api-key "${{ secrets.MISTRAL_API_KEY }}" --label ci
          elif echo "$LABELS" | grep -q 'ai:use-zai'; then
            echo "::notice::Provider: Z.AI direkt (ai:use-zai)"
            vibe config set model.provider mistral
            # zai needs no base_url, uses built-in endpoint probing
            export MISTRAL_API_KEY="${{ secrets.MISTRAL_API_KEY }}"
            echo "MISTRAL_API_KEY=$MISTRAL_API_KEY" >> "$GITHUB_ENV"
          else
            echo "::notice::Provider: OpenRouter (Default)"
            vibe config set model.provider mistral
            vibe config set model.base_url https://api.mistral.ai/v1
          fi
          vibe config set agent.max_turns 90
          pip install mcp -q
          vibe mcp add kolibri --url https://public-ui-kolibri-mcp.vercel.app/mcp

      - name: Session-Archiv herunterladen (Phase fixup)
        id: session-dl
        if: steps.preflight.outputs.configured == 'true'
        continue-on-error: true
        uses: actions/download-artifact@v4
        with:
          name: vibe-session-pr-${{ github.event.pull_request.number }}-fixup
          path: /tmp/vibe-session-restore

      - name: Session wiederherstellen
        id: session-restore
        if: steps.preflight.outputs.configured == 'true' && steps.session-dl.outcome == 'success'
        run: |
          if [ -f /tmp/vibe-session-restore/vibe-session.tar.gz ]; then
            mkdir -p "$VIBE_HOME"
            tar -xzf /tmp/vibe-session-restore/vibe-session.tar.gz -C "$VIBE_HOME"
            if [ -f "$VIBE_HOME/session_id.txt" ]; then
              RID=$(cat "$VIBE_HOME/session_id.txt")
              echo "resume_arg=$RID" >> "$GITHUB_OUTPUT"
            fi
          fi

      - name: Auth pruefen (provider-spezifisch)
        if: steps.preflight.outputs.configured == 'true'
        env:
          MISTRAL_API_KEY: ${{ secrets.MISTRAL_API_KEY }}
          GH_TOKEN: ${{ steps.gh-token.outputs.token }}
          PR: ${{ github.event.pull_request.number }}
        run: |
          LABELS=$(gh pr view $PR --repo $GITHUB_REPOSITORY --json labels --jq '.labels[].name' 2>/dev/null || echo "")
          if echo "$LABELS" | grep -q 'ai:use-nous'; then
            if [ -z "$MISTRAL_API_KEY" ]; then
              echo "::error title=Auth fehlt::MISTRAL_API_KEY nicht gesetzt -- als Repo-Secret hinterlegen"
              exit 1
            fi
            echo "MISTRAL_API_KEY vorhanden."
          elif echo "$LABELS" | grep -q 'ai:use-zai'; then
            if [ -z "$MISTRAL_API_KEY" ]; then
              echo "::error title=Auth fehlt::MISTRAL_API_KEY nicht gesetzt -- als Repo-Secret hinterlegen"
              exit 1
            fi
            echo "MISTRAL_API_KEY vorhanden."
          else
            if [ -z "$MISTRAL_API_KEY" ]; then
              echo "::error title=Auth fehlt::MISTRAL_API_KEY nicht gesetzt -- als Repo-Secret hinterlegen (siehe https://console.mistral.ai/)"
              exit 1
            fi
          fi

      - name: pnpm einrichten
        if: steps.preflight.outputs.configured == 'true'
        uses: pnpm/action-setup@0ebf47130e4866e96fce0953f49152a61190b271 # v6.0.9

      - name: Node.js einrichten
        if: steps.preflight.outputs.configured == 'true'
        uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6.4.0
        with:
          node-version-file: .nvmrc
          cache: pnpm

      - name: Abhaengigkeiten installieren
        if: steps.preflight.outputs.configured == 'true'
        run: pnpm install --frozen-lockfile

      - name: Git-Hooks installieren (lefthook)
        if: steps.preflight.outputs.configured == 'true'
        run: pnpm exec lefthook install

      # Merge-Konflikte erkennen und automatisch aufloesen (VOR dem LLM-Schritt)
      - name: Merge-Konflikte pruefen und aufloesen
        id: resolve-conflicts
        if: steps.preflight.outputs.configured == 'true'
        env:
          GH_TOKEN: ${{ steps.gh-token.outputs.token }}
          PR: ${{ github.event.pull_request.number }}
          REPO: ${{ github.repository }}
          TARGET_BRANCH: ${{ github.event.pull_request.base.ref }}
          HEAD_BRANCH: ${{ github.event.pull_request.head.ref }}
        run: |
          set -euo pipefail
          if ! state_json="$(gh pr view "$PR" --repo "$REPO" --json mergeable,mergeStateStatus 2>/dev/null)"; then
            echo "conflict=unknown" >> "$GITHUB_OUTPUT"; exit 0
          fi
          mergeable="$(echo "$state_json" | jq -r '.mergeable')"
          merge_state="$(echo "$state_json" | jq -r '.mergeStateStatus')"
          if [ "$mergeable" = "MERGEABLE" ]; then echo "conflict=false" >> "$GITHUB_OUTPUT"; exit 0; fi
          if [ "$mergeable" = "UNKNOWN" ] || [ "$mergeable" = "null" ]; then
            sleep 5
            state_json="$(gh pr view "$PR" --repo "$REPO" --json mergeable,mergeStateStatus 2>/dev/null || true)"
            mergeable="$(echo "$state_json" | jq -r '.mergeable' 2>/dev/null || echo 'UNKNOWN')"
          fi
          if [ "$mergeable" = "UNKNOWN" ]; then echo "conflict=unknown" >> "$GITHUB_OUTPUT"; exit 0; fi
          if [ "$merge_state" = "DIRTY" ] || [ "$mergeable" = "CONFLICTING" ]; then
            git fetch origin "$TARGET_BRANCH" --depth=1 --no-tags
            if git merge origin/"$TARGET_BRANCH" --no-ff --no-edit -m "Auto-merge: resolve conflicts for PR #$PR" 2>/dev/null; then
              git push origin HEAD:"$HEAD_BRANCH"
              echo "conflict=resolved" >> "$GITHUB_OUTPUT"
            else
              if git diff --name-only --diff-filter=U | grep -q .; then
                echo "conflict=needs_resolution" >> "$GITHUB_OUTPUT"
              else
                git merge --abort 2>/dev/null || true
                echo "conflict=aborted" >> "$GITHUB_OUTPUT"
              fi
            fi
          fi

      # Stop-Guard: > 10 PR-Commits ? Loop stoppen
      - name: Stop-Guard (> 10 PR-Commits)
        id: stop-guard
        if: steps.preflight.outputs.configured == 'true'
        env:
          GH_TOKEN: ${{ steps.gh-token.outputs.token }}
          PR: ${{ github.event.pull_request.number }}
          REPO: ${{ github.repository }}
        run: |
          if ! commits="$(gh pr view "$PR" --repo "$REPO" --json commits --jq '.commits | length' 2>/dev/null)"; then
            echo "stop=true" >> "$GITHUB_OUTPUT"
            gh pr comment "$PR" --repo "$REPO" --body "? Stop-Guard: gh-API nicht erreichbar -- fail-closed." 2>/dev/null || true
            exit 0
          fi
          if [ "${commits:-0}" -gt 10 ]; then
            echo "stop=true" >> "$GITHUB_OUTPUT"
            gh pr comment "$PR" --repo "$REPO" --body "? **Stop-Guard: Fixup-Loop gestoppt** (${commits} Commits > 10). Bitte manuell pruefen." 2>/dev/null || true
            exit 0
          fi
          echo "stop=false" >> "$GITHUB_OUTPUT"

      - name: Supersede-Check
        id: supersede-check
        if: steps.preflight.outputs.configured == 'true' && steps.stop-guard.outputs.stop != 'true'
        env:
          GH_TOKEN: ${{ steps.gh-token.outputs.token }}
          HEAD_BRANCH: ${{ github.event.pull_request.head.ref }}
        run: |
          running=$(gh api repos/${GITHUB_REPOSITORY}/actions/runs \
            --jq '.workflow_runs[] | select(.name == "Mistral Vibe PR Fixup (Findings umsetzen)" and (.status == "queued" or .status == "in_progress") and .head_branch == $ENV.HEAD_BRANCH and .id != ${{ github.run_id }}) | .id' 2>/dev/null | head -1)
          if [ -n "$running" ]; then echo "skip=true" >> "$GITHUB_OUTPUT"; fi

      - name: Findings umsetzen via Mistral Vibe (Provider per Label)
        id: vibe
        if: steps.preflight.outputs.configured == 'true' && steps.stop-guard.outputs.stop != 'true' && steps.supersede-check.outputs.skip != 'true'
        env:
          MISTRAL_API_KEY: ${{ secrets.MISTRAL_API_KEY }}
          GH_TOKEN: ${{ steps.gh-token.outputs.token }}
          PR: ${{ github.event.pull_request.number }}
        run: |
          # Provider und Modell anhand des PR-Labels waehlen
          LABELS=$(gh pr view $PR --repo $GITHUB_REPOSITORY --json labels --jq '.labels[].name' 2>/dev/null || echo "")
          PROVIDER_FLAG="--provider openrouter"
          MODEL="mistral-large-latest"
          if echo "$LABELS" | grep -q 'ai:use-nous'; then
            PROVIDER_FLAG="--provider nous"
          elif echo "$LABELS" | grep -q 'ai:use-zai'; then
            PROVIDER_FLAG="--provider zai"
            MODEL="z-ai/glm-5.1"
          fi

          cat > /tmp/vibe-prompt.txt << 'VIBE_EOF'
          Auf Pull Request #PR_NR hat der Review das Label `ai:needs-changes` gesetzt. Arbeite die offenen Kreuzverhoer-Findings ab.

          Vorgehen:
            0. KONFLIKTAUFLOeSUNG (falls noetig): Pruefe mit git status und git diff --name-only --diff-filter=U auf Merge-Konflikte. Bei Konflikten: analysieren, eindeutig aufloesen, git add, git commit, git push. Erst DANN mit Findings weitermachen.
            1. Beginne SOFORT mit der Arbeit -- keine Wartezeit!
            2. Findings lesen: gh pr view, gh pr diff, Review-Threads (gh api .../pulls/PR_NR/comments) und CI (gh pr checks).
            3. Zutreffende, EINDEUTIGE Findings fixen: Code aendern, vor jedem Commit lokale Checks: pnpm format && pnpm exec prettier --check . && pnpm lint && pnpm knip. Erst wenn alle gruen, committen und pushen. Im jeweiligen Thread antworten und aufloesen. Mehrdeutige/grosse Punkte dem Menschen ueberlassen.
            4. ABSCHLUSS (ALLERLETZTER Schritt, NIE davor -- erst nach Commit+Push): Labels in ZWEI getrennten Befehlen: gh pr edit PR_NR --remove-label ai:needs-changes, dann --add-label ai:needs-review.

          WEICHES ZEITLIMIT (Soft-Abort):
            Beginne SOFORT mit der Arbeit. Pruefe VOR jedem groesseren Teilschritt date +%s gegen SOFT_DEADLINE. Ist das Limit erreicht: committen+pushen, offene Findings als PR-Kommentar festhalten. gh pr edit PR_NR --add-label ai:continued, dann ai:needs-changes entfernen+sofort wieder setzen (Selbst-Retrigger). KEIN ai:needs-review. Turn beenden.

          Stop-Guard: Ein Workflow-Step zaehlt die PR-Commits und stoppt bei > 10 -- du musst das nicht selbst im Kopf fuehren.

          Keine interaktive Rueckfrage. Label ai:needs-changes autorisiert den Lauf.
          VIBE_EOF

          sed -i "s/#PR_NR/${{ github.event.pull_request.number }}/g" /tmp/vibe-prompt.txt
          sed -i "s/SOFT_DEADLINE/${{ steps.starttime.outputs.soft_deadline_epoch }}/g" /tmp/vibe-prompt.txt

          RESUME_ARG=""
          if [ -n "${{ steps.session-restore.outputs.resume_arg }}" ]; then
            RESUME_ARG="--resume ${{ steps.session-restore.outputs.resume_arg }}"
          fi

          vibe chat -q "$(cat /tmp/vibe-prompt.txt)" \
            $RESUME_ARG \
            -Q --yolo $PROVIDER_FLAG \
            -m "$MODEL" \
            -t "terminal,file" \
            --max-turns 90 \
            --accept-hooks \
            2>&1 | tee /tmp/vibe-output.log
          # PIPESTATUS: Exit-Code von vibe chat durch pipe propagieren
          test "${PIPESTATUS[0]}" -eq 0 || exit "${PIPESTATUS[0]}"

      - name: Mistral Vibe-Session-ID erfassen
        if: always()
        id: session
        run: |
          if [ -f /tmp/vibe-output.log ]; then
            sid="$(grep '^session_id:' /tmp/vibe-output.log | head -1 | sed 's/^session_id:[[:space:]]*//')"
            if [ -n "$sid" ]; then echo "session_id=$sid" >> "$GITHUB_OUTPUT"; fi
          fi

      - name: Session-Archiv packen
        if: always() && steps.session.outputs.session_id != ''
        continue-on-error: true
        run: |
          SID="${{ steps.session.outputs.session_id }}"
          if [ -n "$SID" ] && [ -d "$VIBE_HOME" ]; then
            echo "$SID" > "$VIBE_HOME/session_id.txt"
            tar -czf /tmp/vibe-session.tar.gz -C "$VIBE_HOME" .
          fi

      - name: Session hochladen
        if: always() && steps.session.outputs.session_id != ''
        continue-on-error: true
        uses: actions/upload-artifact@v4
        with:
          name: vibe-session-pr-${{ github.event.pull_request.number }}-fixup
          path: /tmp/vibe-session.tar.gz
          retention-days: 30
          overwrite: true

      - name: Soft-Abort-Fortsetzung erkennen und begrenzen (ai:continued)
        if: always() && steps.preflight.outputs.configured == 'true' && steps.vibe.outcome == 'success'
        env:
          GH_TOKEN: ${{ steps.gh-token.outputs.token }}
          PR: ${{ github.event.pull_request.number }}
          ALREADY_CONTINUED: ${{ steps.continued-before.outputs.already }}
        run: |
          has_continued="$(gh pr view "$PR" --repo "$GITHUB_REPOSITORY" --json labels --jq 'any(.labels[]; .name == "ai:continued")' 2>/dev/null || echo false)"
          if [ "${has_continued:-false}" != "true" ]; then exit 0; fi
          if [ "${ALREADY_CONTINUED:-false}" = "true" ]; then
            gh pr comment "$PR" --repo "$GITHUB_REPOSITORY" --body "? Fixup-Fortsetzungs-Obergrenze erreicht -- bitte manuell pruefen." 2>/dev/null || true
          fi

      - name: Ergebnis zusammenfassen
        if: always() && steps.preflight.outputs.configured == 'true'
        env:
          GH_TOKEN: ${{ steps.gh-token.outputs.token }}
          PR: ${{ github.event.pull_request.number }}
          OUTCOME: ${{ steps.vibe.outcome }}
          SESSION_ID: ${{ steps.session.outputs.session_id }}
        run: |
          labels="$(gh pr view "$PR" --repo "$GITHUB_REPOSITORY" --json labels --jq '[.labels[].name] | join(", ")' 2>/dev/null || true)"
          if [ "$OUTCOME" = "success" ]; then
            echo "::notice title=? Fixup erfolgreich::PR #${PR}"
          elif [ "$OUTCOME" = "cancelled" ]; then
            echo "::warning title=?? Fixup abgebrochen"
          else
            echo "::error title=? Fixup fehlgeschlagen"
          fi
          {
            echo "### Fixup #${PR}"
            echo "- Mistral Vibe-Schritt: \`${OUTCOME:-unbekannt}\`"
            echo "- Labels: ${labels:-keine}"
            if [ -n "$SESSION_ID" ]; then echo "- Session-ID: \`${SESSION_ID}\`"; fi
          } >> "$GITHUB_STEP_SUMMARY"
