{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "node",
		"ignoreDeprecations": "6.0",
		"strict": true,
		"esModuleInterop": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"allowJs": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "src/**/*.test.ts", "src/test/**"]
}
