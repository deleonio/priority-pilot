{
	"name": "priority-pilot",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "pnpm build:api && pnpm build:ts",
		"build:api": "openapi-typescript ../openapi.yml -o src/api.d.ts",
		"build:ts": "tsc",
		"dev": "nodemon",
		"format": "prettier .",
		"lint": "pnpm build:api && tsc --noemit && eslint src",
		"test": "DATABASE_STORAGE=:memory: node --import tsx --test \"src/**/*.test.ts\"",
		"test:coverage": "DATABASE_STORAGE=:memory: node --import tsx --test --experimental-test-coverage --test-coverage-include='src/logics/**' --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=85 \"src/**/*.test.ts\""
	},
	"dependencies": {
		"express": "5.2.1",
		"sequelize": "6.37.8",
		"sqlite3": "6.0.1"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/express": "5.0.6",
		"@types/node": "25.9.4",
		"@typescript-eslint/eslint-plugin": "8.62.0",
		"@typescript-eslint/parser": "8.62.0",
		"eslint": "10.6.0",
		"nodemon": "3.1.14",
		"openapi-typescript": "7.13.0",
		"tsx": "4.22.4",
		"typescript": "6.0.3"
	}
}
