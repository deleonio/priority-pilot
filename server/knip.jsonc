{
	"entry": ["src/index.ts"],
	"ignore": [
		// Auto-generiert aus openapi.yml — Type-Definition, kein Quellcode
		"src/api.d.ts",
		// LLM-Files: Experimentell, wird von Tests abgedeckt — keine statische Analyse nötig
		"src/llm/index.ts",
		"src/llm/llm.ts",
	],
	// tsx wird als devDependency benötigt (test:node mit tsx) — keine false positive
	// dejavu-fonts-ttf liefert die PDF-Schrift (#2233), aufgelöst per require.resolve-String — kein Import
	// mysql2 ist der Sequelize-Treiber für DB_DIALECT=mysql (#2825) — von sequelize dynamisch geladen
	"ignoreDependencies": ["tsx", "dejavu-fonts-ttf", "mysql2"],
	// In-Datei genutzte Exports (z. B. ensureColumns, #2552) gelten als benutzt — der Zugriff der
	// Spec-Tests über das migrateModule-Cast-Muster löst knip nicht auf.
	"ignoreExportsUsedInFile": true,
}
