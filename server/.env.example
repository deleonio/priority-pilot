# Beispiel-Umgebungskonfiguration für den Server.
# Kopieren nach `server/.env` und Werte eintragen — `.env` ist gitignored und wird beim Start
# automatisch geladen (siehe server/src/env.ts). Echte Umgebungsvariablen (z. B. Deployment-Secrets)
# haben Vorrang.

# ==========================================
# LLM-Provider (Säulen-Klassifikation, Text-Parsing, Aktivitäten-Berater, Lektorat)
# Fixe Built-ins: Mistral und OpenRouter sind immer angelegt und nicht lösch-/bearbeitbar —
# Key und Default-Modell kommen aus diesen ENV-Variablen. Ist kein Custom-Provider gewählt,
# übernimmt der Fallback: Mistral (wenn MISTRAL_API_KEY gesetzt), sonst OpenRouter.
# Custom-Provider (Name, URL, Token) legst du zur Laufzeit in der App an
# (Einstellungen → KI-Provider). Siehe docs/llm-providers.md.
# ==========================================

# Mistral-API-Key (Built-in #1). Schlüssel: https://console.mistral.ai
MISTRAL_API_KEY=
# Optionale Basis-URL (Default: https://api.mistral.ai/v1).
# MISTRAL_API_URL=https://api.mistral.ai/v1
# Optionales Default-Modell (Default: mistral-small-latest) — gilt, bis in der App ein Modell gewählt wird.
# MISTRAL_MODEL=mistral-medium-latest

# OpenRouter-API-Key (Built-in #2). Schlüssel: https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# Optionale Basis-URL (Default: https://openrouter.ai/api/v1).
# OPENROUTER_API_URL=https://openrouter.ai/api/v1
# Optionales Default-Modell (Default: openrouter/free) — gilt, bis in der App ein Modell gewählt wird.
# OPENROUTER_MODEL=openrouter/free

# Setzt die SQLite-Datenbank beim Start zurück (Datenverlust!). Default: aus.
# DB_RESET=true

# Sät die Demo-Daten beim Start. Default: an; in Produktion `false` setzen, um keine Demo-Aufgaben
# anzulegen. Die fünf Lebensbalance-Säulen (Stammdaten) bleiben davon unberührt.
# DB_SEED=false

# Speicherort der SQLite-Datenbank (Default: ./database.sqlite, ':memory:' für flüchtig).
# DATABASE_STORAGE=./database.sqlite

# Port des Express-Servers (Default: 3000).
# PORT=3000

# ==========================================
# Google OAuth (für Frontend-Auth-Flow)
# ==========================================

# Google OAuth Client ID aus der Google Cloud Console (Credentials → OAuth 2.0-Client-ID).
# Pflicht, wenn Google-Login aktiviert ist.
GOOGLE_CLIENT_ID=

# Google OAuth Client Secret aus der Google Cloud Console.
# Pflicht, wenn Google-Login aktiviert ist.
GOOGLE_CLIENT_SECRET=

# OAuth Callback URL, die in der Google Cloud Console als "Authorized redirect URI" konfiguriert sein muss.
# MUSS exakt mit der URI übereinstimmen, die Google aufruft (Schema, Host, Pfad).
# Beispiel für Produktion: https://example.de/auth/google/callback
# Beispiel lokal: http://localhost:3000/auth/google/callback
GOOGLE_CALLBACK_URL=

# Erlaubte E-Mail-Adressen für Google-Login (durch Komma getrennt, keine Leerzeichen).
# Nur diese E-Mails dürfen sich einloggen. Pflicht bei aktiviertem Google-Login; in Produktion
# startet der Server ohne Eintrag nicht. Es gibt keine Registrierung: Ein Nutzerkonto entsteht
# erst beim ersten erfolgreichen Google-Login einer hier gelisteten Adresse. Nicht gelistete
# Adressen werden abgewiesen, ohne dass ein Konto angelegt wird. Nach einer Änderung Backend
# neu starten (die Liste wird nur beim Start gelesen). Siehe docs/auth-setup.md.
# Beispiel: user1@example.de,user2@example.de
GOOGLE_ALLOWED_EMAILS=

# Offene Registrierung für die öffentliche Website: true lässt jedes Google-Konto zu, die Allowlist
# oben ist dann nicht nötig. Siehe docs/auth-setup.md und docs/adr/0015-*.
# OPEN_SIGNUP=true

# Administrator-Konten (Rollensystem admin/member): Diese E-Mail-Adressen werden bei
# Registrierung, Passwort-Login und Google-Login automatisch zu `admin` befördert.
# Format wie GOOGLE_ALLOWED_EMAILS (Komma-getrennt) oder JSON-Array; Vergleich ohne
# Groß-/Kleinschreibung. Nur Beförderung — ein hier entferntes Konto bleibt Admin, bis es in
# den Einstellungen unter „Nutzerverwaltung" zurückgestuft wird. Alle anderen Konten sind `member`.
# Beispiel: admin@example.de
ADMIN_EMAILS=

# ==========================================
# Session-Konfiguration
# ==========================================

# Secret für Session-Cookie-Signierung (zufällige, lange Zeichenkette).
# In Produktion zwingend erforderlich (sonst Warnung). Localfallback für Entwicklung.
SESSION_SECRET=

# Session-TTL in Sekunden (Default: 604800 = 7 Tage, Issue #396 PR A).
# Nach Ablauf muss sich der Nutzer neu einloggen.
SESSION_TTL=604800

# ==========================================
# Web-Push (PWA Push-Nachrichten, Issue #355)
# ==========================================

# VAPID-Schlüsselpaar für Web-Push. Einmalig erzeugen mit:
#   npx web-push generate-vapid-keys
# Der öffentliche Schlüssel wird dem Browser über GET /push/vapid-public-key ausgeliefert; der
# private Schlüssel bleibt geheim (nur Server). Fehlen die Schlüssel, sind die /push/*-Endpunkte
# deaktiviert (HTTP 503) — die App läuft ohne Push normal weiter.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Kontakt-Subject für Web-Push (mailto: oder https:-URL), Teil des VAPID-Vertrags.
# Default: mailto:admin@example.com
VAPID_SUBJECT=

# Push an die Android-App über Firebase Cloud Messaging (HTTP v1, ADR 0016). Pfad zur JSON-
# Schlüsseldatei eines Service-Accounts aus der Firebase-Konsole (Projekteinstellungen →
# Dienstkonten → Neuen privaten Schlüssel generieren). Die Datei bleibt geheim und liegt außerhalb
# des Repos. Fehlt der Wert, gehen Benachrichtigungen nur per Web-Push raus.
# FCM_SERVICE_ACCOUNT_FILE=/srv/balamentum/fcm-service-account.json

# Aktiviert den server-internen Erinnerungs-Scheduler (fällige Aufgaben, Issue #355). Läuft ohnehin
# nur, wenn zusätzlich Web-Push (VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY) oder FCM
# (FCM_SERVICE_ACCOUNT_FILE) konfiguriert ist. Default: aus (kein stiller Hintergrundlauf ohne
# bewusstes Opt-in).
# PUSH_REMINDERS_ENABLED=true

# Tagesstunde (0–23, UTC), ab der die tägliche Erinnerung an fällige Aufgaben
# frühestens ausgelöst wird. Default: 8.
# PUSH_REMINDERS_HOUR=8

# ==========================================
# SMTP-Mail (zweiter Benachrichtigungskanal neben Web-Push, Issue #1426)
# ==========================================

# So loggt sich der Server beim Mail-Provider ein: nodemailer verbindet sich zu SMTP_HOST und
# authentifiziert sich per SMTP-AUTH mit SMTP_USER/SMTP_PASSWORD. SMTP_USER ist ein technisches
# Postfach (z. B. system@deinedomain.de), kein persönliches Konto — bei Gmail/Google Workspace
# die Google-Adresse plus App-Passwort (2FA nötig, normale Passwörter werden abgelehnt).
#
# Pflichtwerte: SMTP_HOST und MAIL_FROM — fehlt einer, bleibt der Mail-Kanal deaktiviert und die
# App läuft ohne Mail normal weiter (Push unverändert). Ist SMTP konfiguriert, verschicken die drei
# fachlichen Trigger (tägliche Erinnerung, Serien-Generierung, Aufgabe erledigt) zusätzlich zur
# Push-Nachricht je eine Mail: Empfänger ist jeweils user.email (die Google-Login-Adresse des
# Nutzers), Absender ist MAIL_FROM. Admins prüfen den Kanal per POST /mail/test (Testmail an die
# eigene Admin-Adresse; 502 bei Transportfehler). SMTP_PASSWORD erscheint in keinem Log.
SMTP_HOST=

# SMTP-Port (Default: 587 = STARTTLS).
SMTP_PORT=587

# Implizites TLS ab Verbindungsaufbau (i. d. R. Port 465). Default: false (STARTTLS).
# SMTP_SECURE=false

# SMTP-Login; nur wenn SMTP_USER gesetzt ist, wird SMTP_PASSWORD als Passwort mitgesendet.
# SMTP_USER=system@deinedomain.de
# SMTP_PASSWORD=

# Absender (From:) der Mails. Pflicht (zusammen mit SMTP_HOST).
# MAIL_FROM=Balamentum <system@deinedomain.de>
MAIL_FROM=

# Öffentliche Adresse der Instanz (ohne abschließenden Slash). Zusammen mit SMTP_HOST und MAIL_FROM
# schaltet sie den Anmeldelink per E-Mail (Magic Link) frei; der Link zeigt auf <URL>/app/?magic=….
# Bewusst eine eigene Variable statt des Host-Headers (Schutz vor Links auf fremde Domains).
# PUBLIC_BASE_URL=https://priority-pilot.example.de

# Bei konfiguriertem SMTP verschickt der Server beim Start in Produktion (NODE_ENV=production)
# zusätzlich eine Status-Mail an alle Admin-Nutzer: Commit-SHA, Zeitpunkt, Node-Version. Empfänger
# sind die Nutzer mit Rolle admin (E-Mail = Google-Login-Adresse). Optional CC-Ziel je Status-Mail:
# STATUS_MAIL_CC=betrieb@deinedomain.de

# App-Feedback nach Obsidian (Issue #1435)
# ==========================================

# Personal Access Token mit Schreibrecht auf die Contents-API des Feedback-Repos. Pflicht:
# ohne Token antwortet POST /feedback mit HTTP 503 (die App läuft ansonsten normal weiter).
FEEDBACK_GITHUB_TOKEN=

# Zielrepository im Format <owner>/<repo>. Default: deleonio/Obsidian
# FEEDBACK_GITHUB_REPO=deleonio/Obsidian

# Branch, auf dem die Feedback-Dateien landen — niemals main. Existiert er nicht, legt der
# Server ihn beim ersten Feedback von main aus an. Default: app-feedback
# FEEDBACK_GITHUB_BRANCH=app-feedback

# Ordner im Repo, in den die Markdown-Dateien geschrieben werden. Default: Feedback
# FEEDBACK_GITHUB_DIR=Feedback

# --- Google Play (ADR 0017) -------------------------------------------------
# Service-Account für die Play Developer API: Käufe aus der Android-App prüfen und bestätigen. Pfad
# zur JSON-Schlüsseldatei; der Account braucht in der Play Console Zugriff auf die App (Finanzdaten,
# Bestellungen und Abos). Fehlt der Wert, startet der Server normal, Käufe aus der App scheitern mit
# „nicht konfiguriert“.
# GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/srv/balamentum/play-service-account.json

# Real-time Developer Notifications (POST /billing/google/rtdn) kommen als Pub/Sub-Push mit OIDC-Token.
# GOOGLE_RTDN_AUDIENCE ist die in der Push-Subscription eingetragene Zielgruppe (üblich: die volle öffentliche
# Adresse des Endpunkts). Fehlt sie, lehnt der Endpunkt jede Nachricht mit 401 ab.
# GOOGLE_RTDN_SERVICE_ACCOUNT (optional) ist das Dienstkonto, mit dem die Subscription signiert.
# GOOGLE_RTDN_AUDIENCE=https://example.org/api/v1/billing/google/rtdn
# GOOGLE_RTDN_SERVICE_ACCOUNT=rtdn-push@projekt.iam.gserviceaccount.com

# --- PayPal (Issue #1495) ---------------------------------------------------
# Zugangsdaten der PayPal-REST-App. Nötig, damit der Server die Signatur eingehender
# Webhook-Ereignisse bei PayPal prüfen kann (POST /webhooks/paypal). Fehlen sie, schlägt die
# Prüfung mit "unreachable" fehl — das Ereignis wird abgelegt, aber nicht wirksam.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID des in PayPal angelegten Webhooks (Teil der Signaturprüfung).
PAYPAL_WEBHOOK_ID=
# API-Basis. Default: https://api-m.paypal.com — für die Sandbox:
# https://api-m.sandbox.paypal.com
# PAYPAL_API_BASE=
# Die Plan-IDs je Paket×Zeitraum tragen die Variablennamen aus PAYPAL_PLAN_IDS
# (server/src/logics/plans.ts), z. B. PAYPAL_PLAN_ID_PRO_MONTHLY.

# ==========================================
# Monetarisierung — Rollout (#1463, Runbook docs/deployment.md Abschnitt 7)
# ==========================================
# Rollout-Schalter der Paket-Durchsetzung. Default aus: alle Nutzer behalten alle Funktionen.
# Erst NACH der Übergangs-Setzung einschalten; zurück = Wert entfernen + Neustart, kein Deploy.
# MONETIZATION_ENFORCED=true
# Stichtag der einmaligen Übergangs-Setzung (ISO-Datum), nur für das CLI-Skript
# dist/cli/grandfatherPlans.js — der Serverstart liest ihn nicht.
# GRANDFATHER_CUTOFF=2026-10-01T00:00:00Z
