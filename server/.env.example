# Beispiel-Umgebungskonfiguration für den Server.
# Kopieren nach `server/.env` und Werte eintragen — `.env` ist gitignored und wird beim Start
# automatisch geladen (siehe server/src/env.ts). Echte Umgebungsvariablen (z. B. Deployment-Secrets)
# haben Vorrang.

# Mistral-API-Key für die Säulen-Klassifikation (POST /tasks/suggest-pillars).
# Pflicht, sonst antwortet der Endpoint mit HTTP 503. Schlüssel: https://console.mistral.ai
MISTRAL_API_KEY=

# Optionales Mistral-Modell (Default: mistral-small-latest).
# MISTRAL_MODEL=mistral-small-latest

# Setzt die SQLite-Datenbank beim Start zurück (Datenverlust!). Default: aus.
# DB_RESET=true

# Sät die Demo-Daten beim Start. Default: an; in Produktion `false` setzen, um keine Demo-Aufgaben
# anzulegen. Die fünf Lebensbalance-Säulen (Stammdaten) bleiben davon unberührt.
# DB_SEED=false

# Speicherort der SQLite-Datenbank (Default: ./database.sqlite, ':memory:' für flüchtig).
# DATABASE_STORAGE=./database.sqlite

# Port des Express-Servers (Default: 3000).
# PORT=3000
