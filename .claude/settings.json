{
	"env": {
		"CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
		"BASH_MAX_OUTPUT_LENGTH": "20000",
		"CLAUDE_CODE_NO_FLICKER": "1",
		"API_TIMEOUT_MS": "3000000",
		"ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
		"ANTHROPIC_DEFAULT_OPUS_MODEL": "nvidia/nemotron-3-ultra:free",
        "ANTHROPIC_DEFAULT_FABLE_MODEL": "nvidia/nemotron-3-ultra:free",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "google/gemma-4-31b:free",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "cohere/north-mini-code:free",
        "CLAUDE_CODE_SUBAGENT_MODEL": "cohere/north-mini-code:free"
	},
	"permissions": {
		"allow": ["Agent(*)", "Bash(*)", "Read(*)", "WebFetch(*)"],
		"deny": ["Bash(git commit *)", "Bash(git push *)"]
	},
	"model": "sonnet",
	"tui": "fullscreen",
	"skipWorkflowUsageWarning": true,
	"theme": "dark"
}
