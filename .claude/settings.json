{
	"env": {
		"API_TIMEOUT_MS": "600000",
		"BASH_MAX_OUTPUT_LENGTH": "20000",
		"CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
	},
	"permissions": {
		"allow": ["Agent(*)", "Bash(*)", "Read(*)", "WebFetch(*)", "mcp__kolibri-mcp__*"],
		"deny": [
			"Bash(curl *)",
			"Bash(wget *)",
			"Bash(nc *)",
			"Read(.env)",
			"Read(.env.*)",
			"Read(**/*.pem)",
			"Read(**/secrets/**)",
			"Read(~/.ssh/**)",
			"Read(~/.npmrc)",
			"Bash(rm -rf /*)",
			"Bash(rm -rf ~*)",
			"Bash(sudo *)",
			"Bash(git push * --force*)",
			"Bash(git push --force*)",
			"Bash(git push -f *)"
		]
	},
	"model": "opus",
	"enabledMcpjsonServers": ["kolibri-mcp"]
}
