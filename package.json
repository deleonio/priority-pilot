{
	"devDependencies": {
		"npm-check-updates": "22.2.3",
		"prettier": "3.8.4"
	},
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.1",
	"scripts": {
		"build": "pnpm -r generate && pnpm -r build",
		"format": "prettier --write .",
		"lint": "pnpm -r lint",
		"test": "pnpm -r test",
		"update": "ncu -u && pnpm -r exec ncu -u && pnpm install"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"sqlite3",
			"esbuild"
		]
	}
}
