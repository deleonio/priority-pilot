{
	"version": "0.1.702",
	"license": "EUPL-1.2",
	"devDependencies": {
		"@action-validator/core": "0.6.0",
		"@evilmartians/lefthook": "2.1.12",
		"knip": "6.34.0",
		"prettier": "3.9.6",
		"tsx": "4.23.13"
	},
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"scripts": {
		"build": "pnpm -r generate && pnpm -r build",
		"dev": "pnpm -r --parallel dev",
		"format": "prettier . --write --ignore-unknown",
		"knip": "pnpm -r knip",
		"lint": "pnpm -r lint",
		"lint:actions": "tsx .github/scripts/validate-actions.ts",
		"prepare": "lefthook install",
		"test": "pnpm -r test && pnpm test:scripts",
		"test:scripts": "node --import tsx --test \".github/scripts/*.test.ts\"",
		"ui:inspect": "./ui-inspect.sh"
	}
}
