{
	// Renovate-Konfiguration für dieses pnpm-Monorepo.
	// Doku: https://docs.renovatebot.com/configuration-options/
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',

	// Empfohlene Basis (enthält u. a. GitHub-Actions-Manager, Monorepo-/Gruppierungs-Presets
	// und das Dependency Dashboard).
	extends: [
		'config:recommended',
		// GitHub-Action-Versionen zusätzlich auf Commit-SHA pinnen (Supply-Chain-Härtung) —
		// schreibt `uses: org/action@vX` zu `uses: org/action@<sha> # vX` um.
		'helpers:pinGitHubActionDigests',
	],

	// Zeitzone für Renovate-interne schedules. Aktuell ohne Effekt, da die Zeitplanung allein der
	// Workflow-Cron (.github/workflows/cron.renovate.yml) übernimmt und es bewusst kein top-level
	// `schedule` gibt — bleibt als Reserve, falls künftig ein internes schedule hinzukommt.
	timezone: 'Europe/Berlin',

	// Versionen exakt halten (das Repo nutzt save-exact=true).
	rangeStrategy: 'pin',

	// Commit-/PR-Titel im Conventional-Commits-Stil (erzeugt z. B. "chore(deps): ...").
	semanticCommits: 'enabled',

	// Lockfile (pnpm-lock.yaml) regelmäßig aktualisieren, auch ohne Versions-Bumps.
	lockFileMaintenance: {
		enabled: true,
		// Eigenes Default-Schedule ('before 4am on monday') aufheben — die Zeitsteuerung liegt
		// allein beim Workflow-Cron, sonst liefe die Wartung außerhalb seines Fensters nie.
		schedule: ['at any time'],
	},

	// Automerge: Patch- und Minor-Updates nach grünen Checks mergen.
	automerge: true,
	automergeStrategy: 'squash',
	automergeType: 'pr',

	// Nicht zu viele offene PRs/Branches gleichzeitig.
	prConcurrentLimit: 5,
	prHourlyLimit: 2,

	// pi-Erweiterungen in .pi/settings.json mitpflegen (#1184).
	//
	// WARUM EIN CUSTOM MANAGER: Die Datei ist keine package.json — kein eingebauter Manager
	// findet die Pakete dort. Sie stehen als pi-eigene Quell-Strings ("npm:<paket>@<version>")
	// im `packages`-Array und gelten für CI UND lokale pi-Sessions gleichermaßen.
	//
	// WARUM ÜBERHAUPT GEPINNT: Ohne Version zöge die CI bei jedem Lauf den aktuellen Stand —
	// zwei Läufe basierten dann auf verschiedenen Erweiterungsversionen und wären als
	// Kostenvergleich wertlos (genau die Messung, für die die pi-Laufzeit eingeführt wurde).
	// Pinnen allein ließe die Pakete aber veralten; erst dieser Manager macht daraus
	// "gepinnt UND gepflegt".
	customManagers: [
		{
			// Glob statt /regex/: Der Pfad enthält einen Schrägstrich, der in der
			// Regex-Schreibweise das Muster vorzeitig beenden würde.
			customType: 'regex',
			managerFilePatterns: ['.pi/settings.json'],
			// Fängt beide erlaubten Schreibweisen ab: den blossen Quell-String und die
			// Objektform mit Ressourcen-Filtern ("source": "npm:…"). Scope-Pakete
			// (@narumitw/pi-lsp) sind eingeschlossen.
			matchStrings: ['"(?:source"\\s*:\\s*")?npm:(?<depName>@?[^"@]+)@(?<currentValue>[^"]+)"'],
			datasourceTemplate: 'npm',
		},
	],

	packageRules: [
		{
			// pi-Erweiterungen als eigene Gruppe: Sie aendern das VERHALTEN des Agenten (Subagents,
			// MCP, LSP), nicht nur Bibliothekscode — als ein PR statt getrennter Streams, damit sie
			// zueinander passend bleiben. Automerge wie alle Nicht-Major-Updates; ein automatischer
			// Bump kann die Kosten-Messbasis zwischen zwei Pipeline-Laeufen verschieben (bewusst
			// in Kauf genommen, s. .costs/). Die pi-CLI selbst zieht setup-pi ungepinnt als
			// @latest je Lauf — kein Renovate-Manager mehr dafür.
			matchFileNames: ['.pi/settings.json'],
			groupName: 'pi-Erweiterungen',
			labels: ['dependencies', 'pi'],
		},
		{
			// devDependencies: Patch- und Minor-Updates in einem PR bündeln.
			matchDepTypes: ['devDependencies'],
			matchUpdateTypes: ['patch', 'minor'],
			groupName: 'devDependencies (non-major)',
		},
		{
			// pnpm-Workspace-Overrides (Security-Pins in pnpm-workspace.yaml): Major-Vorschläge
			// unterdrücken — die Pins sollen auf den getesteten GHSA-Fixes bleiben (z. B.
			// "auf 2.x/4.x bleiben"); ein neuer Pin ist eine bewusste Entscheidung.
			matchDepTypes: ['pnpm-workspace.overrides'],
			matchUpdateTypes: ['major'],
			enabled: false,
		},
		{
			// ... und Patch-/Minor-Bumps innerhalb der Pins in einem PR bündeln —
			// hält die Pins aktuell, ohne bis zu 12 einzelne PR-Streams zu erzeugen.
			matchDepTypes: ['pnpm-workspace.overrides'],
			groupName: 'pnpm overrides (Security-Pins)',
		},
		{
			// GitHub-Actions-Updates separat gruppieren.
			matchManagers: ['github-actions'],
			groupName: 'GitHub Actions',
		},
		{
			// Playwright npm-Paket und E2E-Docker-Image MÜSSEN synchron bleiben (s. Kommentar
			// "ACHTUNG" in .github/workflows/verify.yml beim e2e-Job): der Container ist auf eine
			// feste Tag-Version gepinnt, die zur @playwright/test-Version passen muss, sonst fehlt
			// im Container das passende Browser-Binary und ALLE E2E-Shards schlagen fehl
			// ("browserType.launch: Executable doesn't exist"). Ohne diese Regel landen beide
			// Updates in getrennten Gruppen (devDependencies bzw. GitHub Actions) und blockieren
			// sich gegenseitig, weil automerge nur bei komplett grünen Checks greift.
			matchPackageNames: ['@playwright/test', 'mcr.microsoft.com/playwright'],
			groupName: 'playwright (npm + docker image)',
		},
		{
			// Node/pnpm-Engines nur als eigener PR (potenziell breaking).
			matchPackageNames: ['node', 'pnpm'],
			matchDepTypes: ['engines', 'packageManager'],
			groupName: 'Toolchain (Node / pnpm)',
		},
		{
			// Major-Updates immer einzeln, mit Hinweis im Titel — und ohne Automerge (menschlicher
			// Blick auf Breaking Changes): top-level automerge:true gilt sonst auch hier.
			matchUpdateTypes: ['major'],
			automerge: false,
			labels: ['dependencies', 'major'],
		},
		{
			// KoliBri (@public-ui/*) gemeinsam. Die vier Pakete muessen zueinander passen — ein
			// einzeln gebumptes Theme gegen alte Komponenten bricht das Styling stumm. Automerge
			// wie alle Nicht-Major-Updates. ACHTUNG: Das Frontend steht bewusst auf einem
			// dev-Snapshot mit Dunkelmodus (4.5.0-rc.0, PR #1405) — ein Bump auf den stabilen
			// `latest`-Tag ist semver-technisch KEIN Major (major.minor.patch bleiben gleich) und
			// mergt unter dieser Regel automatisch durch, waere aber ein Downgrade und drehte den
			// Dunkelmodus zurueck. Bewusst in Kauf genommen (s. PR, das diese Zeile geaendert hat);
			// wer das nicht will, muss @public-ui/** vor dem naechsten stable Release wieder aus
			// dem Automerge nehmen.
			matchPackageNames: ['@public-ui/**'],
			groupName: 'KoliBri (@public-ui)',
			labels: ['dependencies', 'kolibri'],
		},
	],

	// Sicherheitslücken (GitHub Advisories) priorisiert beheben.
	vulnerabilityAlerts: {
		labels: ['security'],
	},

	labels: ['dependencies'],
}
