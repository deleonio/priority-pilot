{
	// Renovate-Konfiguration für dieses pnpm-Monorepo.
	// Doku: https://docs.renovatebot.com/configuration-options/
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',

	// Empfohlene Basis (inkl. GitHub-Actions-Manager, Dependency Dashboard u. a.).
	extends: [
		'config:recommended',
		// Mehrere kleine Updates zu sinnvollen Gruppen-PRs zusammenfassen.
		'group:monorepos',
		'group:recommended',
		// Übliche Verdächtige automatisch zusammenfassen (z. B. @types, eslint, prettier-Plugins).
		'helpers:pinGitHubActionDigests',
	],

	// Deutsche Issue-/PR-Sprache passt zum restlichen Repo.
	timezone: 'Europe/Berlin',
	// Zeitplanung steuert der Workflow-Cron (.github/workflows/renovate.yml), daher hier kein
	// schedule — sonst wuerde Renovate nur im Schnittfenster aus Cron UND schedule aktiv.

	// Versionen exakt halten (das Repo nutzt save-exact=true).
	rangeStrategy: 'pin',

	// Commit-/PR-Titel im Conventional-Commits-Stil (erzeugt z. B. "chore(deps): ...").
	semanticCommits: 'enabled',

	// Übersicht aller anstehenden Updates als gepinntes Issue.
	dependencyDashboard: true,
	dependencyDashboardTitle: 'Dependency Dashboard',

	// Lockfile (pnpm-lock.yaml) regelmäßig aktualisieren, auch ohne Versions-Bumps.
	lockFileMaintenance: {
		enabled: true,
	},

	// Nicht zu viele offene PRs/Branches gleichzeitig.
	prConcurrentLimit: 5,
	prHourlyLimit: 2,

	packageRules: [
		{
			// devDependencies: Patch- und Minor-Updates in einem PR bündeln.
			matchDepTypes: ['devDependencies'],
			matchUpdateTypes: ['patch', 'minor'],
			groupName: 'devDependencies (non-major)',
		},
		{
			// GitHub-Actions-Updates separat gruppieren.
			matchManagers: ['github-actions'],
			groupName: 'GitHub Actions',
		},
		{
			// Node/pnpm-Engines nur als eigener PR (potenziell breaking).
			matchPackageNames: ['node', 'pnpm'],
			matchDepTypes: ['engines', 'packageManager'],
			groupName: 'Toolchain (Node / pnpm)',
		},
		{
			// Major-Updates immer einzeln, mit Hinweis im Titel.
			matchUpdateTypes: ['major'],
			labels: ['dependencies', 'major'],
		},
	],

	// Sicherheitslücken (GitHub Advisories) priorisiert beheben.
	vulnerabilityAlerts: {
		labels: ['security'],
	},

	labels: ['dependencies'],
}
