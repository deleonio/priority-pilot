{
	"entry": ["src/main.tsx"],
	"ignore": [
		// Komplexes Legacy-Component mit vielen dynamischen Imports — false positives
		"src/components/TaskTable.tsx",
		// React-Cell-Root-Adapter füragrid — library-intern, kein Anwendungscode
		"src/lib/reactCellRoot.ts",
		// Series-Management mit Modal-State-Machine — komplexe Typ-Infrastruktur
		"src/components/SeriesManagementModal.tsx",
		// Service Worker für PWA — manuell eingebunden, kein Entry-Point
		"public/push-sw.js",
		// Icon-Generator-Script für Linux-Build — Dev-Tool, kein App-Code
		"public/icons/generate-icons-linux.mjs",
	],
	"ignoreDependencies": ["client"],
}
