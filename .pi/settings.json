{
	"compaction": {
		"enabled": true,
		"reserveTokens": 16384,
		"keepRecentTokens": 20000
	},
	"packages": [
		{
			"source": "npm:pi-subagents@0.64.0",
			"autoload": false,
			"prompts": [
				"+prompts/review-loop.md",
				"+prompts/council.md",
				"+prompts/gather-context-and-clarify.md",
				"+prompts/parallel-cleanup.md",
				"+prompts/parallel-research.md",
				"+prompts/parallel-review.md"
			],
			"extensions": ["+index.ts"],
			"skills": ["+skills/council-mode/SKILL.md", "+skills/pi-subagents/SKILL.md"]
		},
		{
			"source": "npm:pi-mcp-adapter@2.32.1",
			"autoload": false,
			"extensions": ["+index.ts"],
			"skills": ["+skills/mcp-scripting/SKILL.md"]
		},
		{
			"source": "npm:@narumitw/pi-lsp@0.49.6",
			"autoload": false,
			"extensions": ["+dist/index.ts"]
		},
		{
			"source": "npm:pi-web-access@0.27.0",
			"autoload": false,
			"extensions": ["+index.ts"]
		},
		{
			"source": "npm:@entelligentsia/pi-claude-compat@1.2.1",
			"autoload": false,
			"extensions": ["+extensions/claude-compat/index.ts"]
		}
	],
	"retry": {
		"enabled": true,
		"maxRetries": 5,
		"baseDelayMs": 5000,
		"provider": {
			"timeoutMs": 3600000,
			"maxRetries": 0,
			"maxRetryDelayMs": 120000
		}
	},
	"defaultProvider": "zai",
	"defaultModel": "glm-4.7"
}
